---
// Live Washington transit map. Map: src/components/TransitMap.astro. Feeds:
// src/lib/transit-feeds.ts. Routes and stops: scripts/build-transit.ts (weekly).
// A standalone lab, not a page of kylepace.dev: LabLayout gives it only the back link,
// a footer line, display settings and analytics. Its look is src/styles/theme.css
// (plan: design/PLAN.md).
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import '../../styles/theme.css';
import TransitMap from '../../components/TransitMap.astro';
import { systems } from '../../lib/transit-feeds';
import meta from '../../../public/transit/meta.json';

const withData = new Set(meta.systems.filter((_, i) => meta.agencies.some(([s]) => s === i)).map((s) => s.key));
const liveSystems = systems.filter((s) => s.live).sort((a, b) => a.name.localeCompare(b.name));
const scheduleSystems = systems.filter((s) => !s.live && withData.has(s.key)).sort((a, b) => a.name.localeCompare(b.name));
const credits = systems.filter((s) => s.credit).map((s) => s.credit!);
const updated = new Date(meta.updated).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Los_Angeles' });
---

<LabLayout
  title="Washington transit, live"
  description="Every bus, train and ferry in Washington that reports where it is, on one zoomable map, with every route and stop. Updated every 15 seconds."
  image="/transit/share.png"
  imageAlt="Washington transit: the name on a green sign beside a dark map of Puget Sound's transit routes in many colors, dotted with vehicles."
  themeColor={{ light: '#eceee8', dark: '#121719' }}
>
  <ul class="lab-nav" slot="bar">
    <li><a href="/transit/" aria-current="page">Live map</a></li>
    <li><a href="/transit/agencies/">Agencies</a></li>
    <li><a href="#about">About</a></li>
  </ul>

  <TransitMap />

  <div class="below">
    <section class="systems" aria-labelledby="systems-heading">
      <h2 id="systems-heading">Who’s on the map</h2>
      <div class="columns">
        <div>
          <table class="timetable">
            <caption>Live positions</caption>
            <thead>
              <tr>
                <th scope="col">Agency</th>
                <th scope="col" class="num">Moving now</th>
              </tr>
            </thead>
            <tbody>
              {
                liveSystems.map((s) => (
                  <tr data-system={s.key} data-state="loading">
                    <th scope="row">{s.name}</th>
                    <td class="num" data-count>
                      …
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div>
          <h3>Routes and stops only</h3>
          <p class="note">These agencies publish their schedules but not where their vehicles are, so the map shows their routes and stops without vehicles.</p>
          <ul class="names">
            {scheduleSystems.map((s) => <li>{s.name}</li>)}
          </ul>
          <p><a href="/transit/agencies/">See every agency’s network</a></p>
        </div>
      </div>
    </section>

    <section class="about" id="about" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      <p>
        This map shows every bus, train and ferry in Washington that reports where it is, with every route and stop
        around it. Tap a vehicle to see its route and where it’s headed, or search for a route or an agency.
      </p>
      <p>
        Vehicle positions come from each agency’s open live feed (GTFS-realtime) and refresh every 15 seconds. Routes and
        stops come from the schedules the agencies publish (GTFS), rebuilt every week; the last rebuild was {updated}.
        Feeds found through the <a href="https://mobilitydatabase.org">Mobility Database</a> and
        <a href="https://www.transit.land">Transitland</a>. Map tiles by <a href="https://openfreemap.org">OpenFreeMap</a>,
        map data © OpenStreetMap contributors.
      </p>
      <p>
        Privacy: your browser asks OpenFreeMap’s servers for the part of the map you’re looking at. If you use “Find my
        location”, your position stays in your browser. Analytics works the same as the rest of kylepace.dev
        (<a href="https://kylepace.dev/privacy/">privacy</a>).
      </p>
      {credits.map((c) => <p>{c}</p>)}
    </section>
  </div>
</LabLayout>

<style>
  .below {
    padding: var(--space-8) var(--gutter) 0;
    max-width: 68rem;
  }

  h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  h3,
  caption {
    margin: 0 0 var(--space-2);
    font-size: var(--step-0);
    font-weight: 700;
    text-align: left;
  }

  .columns {
    display: grid;
    gap: var(--space-8) var(--space-12);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  /* A timetable: a heavy rule on top, light rules between rows, figures right-aligned. */
  .timetable {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .timetable thead th {
    padding: var(--space-1) 0;
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    color: var(--ink-muted);
    font-weight: 400;
    text-align: left;
  }

  .timetable tbody th,
  .timetable td {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    font-weight: 600;
  }

  .timetable .num,
  .timetable thead th.num {
    text-align: right;
    padding-left: var(--space-4);
    font-variant-numeric: tabular-nums;
  }

  .timetable td.num {
    font-weight: 700;
  }

  /* Not running or not answering: say so, in the quieter ink. */
  [data-state='quiet'] td,
  [data-state='loading'] td,
  [data-state='error'] td {
    font-weight: 400;
    color: var(--ink-muted);
  }

  .note {
    margin: 0 0 var(--space-3);
    max-width: 32em;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .names {
    margin: 0 0 var(--space-4);
    padding: var(--space-2) 0 0;
    border-top: 3px solid var(--ink);
    list-style: none;
    columns: 2 11rem;
    column-gap: var(--space-6);
    font-size: var(--step--1);
  }

  .names li {
    padding: var(--space-1) 0;
    break-inside: avoid;
  }

  .about {
    margin-top: var(--space-12);
    max-width: 40rem;
    font-size: var(--step--1);
  }

  .about h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-2);
  }

  /* Body line length under 70 characters (design/PLAN.md). */
  .about p {
    max-width: 32em;
    margin: 0 0 var(--space-3);
  }
</style>
