{
  // Cloudflare Workers config. The Astro adapter fills in the entry point and static
  // assets at build time; settings here are merged into that.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-transit-map",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Retired: World transit (kyle-pace/world-transit) replaced this map and now claims
  // kylepace.dev/transit, redirecting its old addresses. This Worker keeps its workers.dev
  // address only.
  "workers_dev": true,
  // Secret (not in Git): OBA_API_KEY, the OneBusAway Puget Sound key for Sound Transit,
  // Pierce Transit, WSF and the Seattle Streetcar. Without it the shared TEST key is used.
}
